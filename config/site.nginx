server {
    server_name ~^(?<municipi>.+)\.hidrants\.hopto\.org$;

    root /var/www/app/front/dist;
    index index.html;

    # FRONTEND
    location / {
        try_files $uri /index.html;
    }

    # API/BACKEND
    location /api/ {
        proxy_pass http://localhost:3033/api/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }


    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/hidrants.hopto.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/hidrants.hopto.org/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = hidrants.hopto.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    server_name hidrants.hopto.org;
    listen 80;
    return 404; # managed by Certbot


}