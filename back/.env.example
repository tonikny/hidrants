# Variables d'entorn del Backend (back/.env)

# ============================================================
# OBLIGATÒRIES
# ============================================================

# Clau secreta per signar els tokens JWT (mínim 32 caràcters)
# Pots generar-ne una amb: openssl rand -base64 64
JWT_SECRET=la_teva_clau_secreta_molt_llarga_i_segura_aqui

# Port on escoltarà el servidor backend (default: 3033)
PORT=3033

# ============================================================
# OPCIONALS
# ============================================================

# URL de l'API d'Overpass (default: https://overpass-api.de/api/interpreter)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Nivell de logging de Fastify (default: info)
# Valors possibles: fatal, error, warn, info, debug, trace
FASTIFY_LOGLEVEL=info

# ============================================================
# TELEGRAM (Opcional - per enviar notificacions)
# ============================================================
TELEGRAM_BOT_TOKEN=el_teu_bot_token_de_telegram
TELEGRAM_CHAT_ID=el_teu_chat_id

# ============================================================
# GRAPHHOPPER (Opcional - per càlcul de rutes)
# ============================================================
GRAPHHOPPER_API_KEY=la_teva_api_key_de_graphhopper
