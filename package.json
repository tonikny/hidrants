{
  "scripts": {
    "dev": "concurrently \"npm run dev -w back\" \"sleep 3 && npm run dev -w front\"",
    "build": "npm run build -w front && npm run build -w back",
    "start": "npm run start -w back",
    "lint": "npm run lint -w front && npm run lint -w back",
    "lint:fix": "npm run lint:fix -w front && npm run lint:fix -w back",
    "typecheck": "npm run typecheck -w front && npm run typecheck -w back",
    "format": "prettier . --write",
    "format:check": "prettier . --check .",
    "update:boundaries": "npm run update:boundaries -w back",
    "db:reset": "npm run db:reset -w back",
    "db:seed": "npm run db:seed -w back",
    "db:import-osm": "npm run db:import-osm -w back",
    "db:export-osm": "npm run db:export-osm -w back",
    "db:reset-hidrants": "npm run db:reset-hidrants -w back",
    "db:setup": "npm run db:reset && npm run db:seed && npm run db:import-osm && npm run update:boundaries",
    "mqtt:up": "docker compose up -d mosquitto",
    "mqtt:cleanup": "npm run mqtt:cleanup -w back",
    "mqtt:regen-dynsec": "python3 scripts/init-dynsec.py regen",
    "mqtt:sync-dynsec": "python3 scripts/init-dynsec.py sync",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "docker:clean": "docker image prune -f",
    "docker:deploy": "git pull --ff-only --autostash && npm install && npm run update:boundaries && docker compose up -d --build && docker image prune -f",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.2"
  },
  "private": true,
  "workspaces": [
    "front",
    "back"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
