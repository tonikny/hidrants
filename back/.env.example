# Configuració del Backend - Hidrants ADF

# Domini base de l'aplicació
BASE_DOMAIN_URL = localhost

# Port intern del backend (no canviar si uses Docker)
PORT = 3033

# URL de l'API d'Overpass per importar dades d'OpenStreetMap
OVERPASS_URL = https://overpass-api.de/api/interpreter

# Telegram Bot per notificacions (opcional)
# Crea un bot amb @BotFather i obté el token
TELEGRAM_BOT_TOKEN = your_telegram_bot_token_here
TELEGRAM_CHAT_ID = your_telegram_chat_id_here

# GraphHopper API per càlcul de rutes (opcional)
# Registra't a https://www.graphhopper.com/ per obtenir una clau
GRAPHHOPPER_API_KEY = your_graphhopper_api_key_here

# Nivell de logs de Fastify: trace, debug, info, warn, error, fatal
FASTIFY_LOGLEVEL = warn

# Secret per JWT (CANVIA'L per un valor aleatori i segur en producció)
# Genera'n un amb: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET = changeme_generate_a_secure_random_secret_here

# Configuració MQTT per OwnTracks
# URL del broker MQTT (mosquitto per Docker, localhost:1883 per dev local)
MQTT_BROKER_URL = mqtt://mosquitto:1883
# ID del client MQTT
MQTT_CLIENT_ID = hidrants-back
# Topic a subscriure's (# = wildcard per tots els subtopics)
# IMPORTANT: Usar cometes per evitar que # sigui interpretat com comentari
MQTT_TOPIC = "owntracks/#"
