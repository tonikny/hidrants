# 1. Definició de les zones de cache (Haurien d'estar al bloc 'http' de nginx.conf, però si el teu fitxer s'inclou dins del bloc http funcionaran aquí)
proxy_cache_path /var/cache/nginx/overpass levels=1:2 keys_zone=overpass_cache:10m max_size=1g inactive=7d use_temp_path=off;
proxy_cache_path /var/cache/nginx/tiles levels=1:2 keys_zone=tiles_cache:10m max_size=5g inactive=30d use_temp_path=off;

# 2. REDIRECCIÓ DE HTTP A HTTPS (Domini base i subdominis)
server {
    listen 80;
    server_name .hidrants.hopto.org; # El punt inicial inclou hidrants.hopto.org i *.hidrants.hopto.org
    return 301 https://$host$request_uri;
}

# 3. BLOC SSL UNIFICAT (Domini base i municipis)
server {
    listen 443 ssl;
    server_name hidrants.hopto.org ~^(?<municipi>.+)\.hidrants\.hopto\.org$;

    root /var/www/app/front/dist;
    index index.html;

    # Certificats SSL (Gestionats per Certbot - Opció B Multi-domini)
    ssl_certificate /etc/letsencrypt/live/hidrants.hopto.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hidrants.hopto.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # FRONTEND
    location / {
        try_files $uri /index.html;
    }

    # API / BACKEND (General)
    location /api/ {
        proxy_pass http://localhost:3033/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # CACHE OVERPASS (Mètode POST amb clau basada en el cos)
    location /api/overpass {
        proxy_pass http://localhost:3033/api/overpass;

        proxy_cache overpass_cache;
        proxy_cache_methods POST;
        proxy_cache_key "$host$request_uri|$request_body";
        proxy_cache_valid 200 7d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        
        add_header X-Cache-Status $upstream_cache_status;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # PROXY TILES AMB CACHE
    location /tiles/osm/ {
        proxy_pass https://tile.openstreetmap.org/;
        proxy_cache tiles_cache;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating;
        add_header X-Cache-Status $upstream_cache_status;
        proxy_set_header User-Agent "HidrantsADF/1.0";
    }

    location /tiles/opentopo/ {
        proxy_pass https://tile.opentopomap.org/;
        proxy_cache tiles_cache;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating;
        add_header X-Cache-Status $upstream_cache_status;
    }

    location /tiles/ign-raster/ {
        proxy_pass https://tms-mapa-raster.ign.es/1.0.0/mapa-raster/;
        proxy_cache tiles_cache;
        proxy_cache_valid 200 30d;
        add_header X-Cache-Status $upstream_cache_status;
    }

    location /tiles/ign-orto/ {
        proxy_pass https://tms-pnoa-ma.idee.es/1.0.0/pnoa-ma/;
        proxy_cache tiles_cache;
        proxy_cache_valid 200 30d;
        add_header X-Cache-Status $upstream_cache_status;
    }
}
