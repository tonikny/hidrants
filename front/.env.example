# Variables d'entorn del Frontend (front/.env)

# ============================================================
# OBLIGATÒRIES
# ============================================================

# URL base de l'API
# En desenvolupament amb Vite, apunta al backend via proxy
VITE_API_URL=/api

# ============================================================
# OPCIONALS (Per desenvolupament)
# ============================================================

# Si vols usar HTTPS en local, pots configurar certificats amb vite-plugin-mkcert
# No cal configurar res més - el frontend detecta automàticament l'entorn
